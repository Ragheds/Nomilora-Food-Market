# Copy to .env locally; never commit the real .env.
# Existing Replit PostgreSQL connection string, SERVER ONLY.
DATABASE_URL=
# Supabase AUTH ONLY. Application tables remain in Replit PostgreSQL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Public browser configuration, embedded at Vite build time. Same values as above.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
PORT=8080
APP_ORIGINS=http://localhost:5173,http://localhost:15173
# Optional Stripe TEST MODE ONLY. All three required for hosted test checkout.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
PAYMENT_RETURN_ORIGIN=http://localhost:5173
# Optional private development webhook forwarding via the official Stripe CLI.
# Requires an existing sandbox sk_test_ secret. Never makes the preview public.
NOMILORA_STRIPE_TEST_FORWARD=
# Never put a service-role key, database password or Stripe secret in VITE_*.
# No live-payment, public-launch or real-delivery enablement is implemented.
