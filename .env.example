# Copy to .env locally. Keep the real .env out of Git.
# Existing Replit PostgreSQL connection string: SERVER ONLY.
DATABASE_URL=
# Supabase Auth only; do not move application data into Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# These two values are public configuration, embedded into the Vite build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
PORT=8080
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
